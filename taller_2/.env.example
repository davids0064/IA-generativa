# Configuración por defecto: Ollama en local (modelo open-source, sin costo).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Temperatura baja para priorizar precisión factual sobre creatividad
# (ver mitigación de alucinaciones en la Fase 2).
LLM_TEMPERATURE=0.2

# --- Alternativas (descomentar y ajustar si se usa otro proveedor) ---
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# Groq (Llama open-source vía API)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# --- Taller 2: sistema RAG ---
# Embeddings open-source (bge-m3) servidos por Ollama. Descárgalo con:
#   ollama pull bge-m3
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_BASE_URL=http://localhost:11434
#
# Alternativa propietaria (requiere OPENAI_API_KEY):
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...

# Servidor de ChromaDB (servicio `chroma` de docker-compose). Los agentes solo
# se conectan; la carga se hace una vez con `python -m src.base_conocimiento`.
CHROMA_HOST=localhost
CHROMA_PORT=8000
#
# Sin CHROMA_HOST, ChromaDB se usa en modo embebido y persiste el índice en
# VECTORSTORE_DIR (por defecto data/vectorstore), sin necesidad de Docker.
# VECTORSTORE_DIR=data/vectorstore

# Número de chunks a recuperar por similitud.
RAG_TOP_K=4
